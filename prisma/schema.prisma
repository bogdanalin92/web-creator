generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model block_instances {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  page_id               String            @db.Uuid
  parent_block_id       String?           @db.Uuid
  slot                  String?
  order_index           Int
  block_type_id         String            @db.Uuid
  props                 Json              @default("{}")
  created_at            DateTime          @default(now()) @db.Timestamptz(6)
  updated_at            DateTime          @default(now()) @db.Timestamptz(6)
  block_types           block_types       @relation(fields: [block_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pages                 pages             @relation(fields: [page_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  block_instances       block_instances?  @relation("block_instancesToblock_instances", fields: [parent_block_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_block_instances block_instances[] @relation("block_instancesToblock_instances")

  @@unique([parent_block_id, slot, order_index], map: "ux_block_instances_parent_slot_order_unique")
  @@index([page_id], map: "idx_block_instances_page_id")
  @@index([parent_block_id, slot, order_index], map: "idx_block_instances_parent_slot_order")
}

model block_types {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String            @unique
  category        String
  schema          Json
  version         Int               @default(1)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  block_instances block_instances[]
  template_blocks template_blocks[]
}

model pages {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id         String            @db.Uuid
  path            String
  title           String
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  block_instances block_instances[]
  sites           sites             @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([site_id, path], map: "uq_pages_site_path")
}

model sites {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_user_id String   @db.Uuid
  name          String
  slug          String   @unique
  status        String   @default("draft")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  pages         pages[]
  users         users    @relation(fields: [owner_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model template_blocks {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id           String            @db.Uuid
  parent_block_id       String?           @db.Uuid
  slot                  String?
  order_index           Int
  block_type_id         String            @db.Uuid
  props                 Json              @default("{}")
  block_types           block_types       @relation(fields: [block_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  template_blocks       template_blocks?  @relation("template_blocksTotemplate_blocks", fields: [parent_block_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_template_blocks template_blocks[] @relation("template_blocksTotemplate_blocks")
  templates             templates         @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([parent_block_id, slot, order_index], map: "idx_template_blocks_parent_slot_order")
  @@index([template_id], map: "idx_template_blocks_template_id")
}

model templates {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  niche           String
  description     String?
  preview_url     String?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  template_blocks template_blocks[]
}

model users {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.Citext
  password_hash String
  plan          String
  stripe_customer_id String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  sites         sites[]
}
